# ── Test runner image ─────────────────────────────────
# Installs all dependencies (including test tools) and
# runs pytest as the container entrypoint.
# ──────────────────────────────────────────────────────

FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source and tests.
COPY src/ ./src/
COPY tests/ ./tests/
COPY pytest.ini .

CMD ["pytest", "tests/", "-v", "--tb=short"]
