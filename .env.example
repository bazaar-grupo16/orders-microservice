# ──────────────────────────────────────────────────────
# Environment variables for the Bazaar microservice.
# Copy this file to .env and fill in the real values.
# NEVER commit .env with real credentials to the repo.
# ──────────────────────────────────────────────────────

$env:APP_NAME = "orders-service"
$env:LOG_LEVEL = "info"

# ── Database ─────────────────────────────────────────
$env:DB_HOST = "localhost"
$env:DB_PORT = "5432"
$env:DB_USER = "postgres"
$env:DB_PASSWORD = "changeme"
$env:DB_NAME = "bazaar"

# ── External Services (internal K8s URLs) ────────────
$env:CART_SERVICE_URL = "http://cart-service"
$env:INVENTORY_SERVICE_URL = "http://inventory-service"
$env:PAYMENTS_SERVICE_URL = "http://payments-service"
